# Base URL of the ShadowFlow backend API.
#
# Local dev: leave unset (defaults to http://localhost:8000) or set it below.
# Vercel: set this in Project Settings -> Environment Variables to your
# deployed Render API, e.g. https://shadowflow-api.onrender.com
# It is inlined at build time (NEXT_PUBLIC_*), so rebuild/redeploy after
# changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000